---
import { ArrowDown, ArrowUp, ArrowUpDown, Trash2 } from 'lucide-astro';
import DashboardLayout from '../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Nachrichten">
  <section class="dashboard-page section">
    <div class="container">
      <h2>Eingegangene Nachrichten</h2>
      <div class="toolbar">
        <div class="filter-group" role="group" aria-label="Nachrichten filtern">
          <button type="button" class="filter-button is-active" data-filter="all" aria-pressed="true">Alle</button>
          <button type="button" class="filter-button" data-filter="legit" aria-pressed="false">Gesendet</button>
          <button type="button" class="filter-button" data-filter="spam" aria-pressed="false">Spam</button>
        </div>
        <p id="message-summary" class="message-summary" aria-live="polite"></p>
      </div>
      <div class="table-wrapper">
        <table class="message-table data-table">
          <thead>
            <tr>
              <th scope="col" data-sort="name">
                <button type="button" class="sort-button" data-sort="name">
                  Name <span class="sort-icon" aria-hidden="true"></span>
                </button>
              </th>
              <th scope="col" data-sort="message">
                <button type="button" class="sort-button" data-sort="message">
                  Nachricht <span class="sort-icon" aria-hidden="true"></span>
                </button>
              </th>
              <th scope="col" data-sort="email">
                <button type="button" class="sort-button" data-sort="email">
                  Email <span class="sort-icon" aria-hidden="true"></span>
                </button>
              </th>
              <th scope="col" data-sort="phone">
                <button type="button" class="sort-button" data-sort="phone">
                  Telefon <span class="sort-icon" aria-hidden="true"></span>
                </button>
              </th>
              <th scope="col" data-sort="timestamp">
                <button type="button" class="sort-button" data-sort="timestamp">
                  Zeitpunkt <span class="sort-icon" aria-hidden="true"></span>
                </button>
              </th>
              <th scope="col" data-sort="status">
                <button type="button" class="sort-button" data-sort="status">
                  Status <span class="sort-icon" aria-hidden="true"></span>
                </button>
              </th>
              <th scope="col" class="actions-header">Aktionen</th>
            </tr>
          </thead>
          <tbody id="message-table-body">
            <tr>
              <td colspan="7">Lade Nachrichten...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <template id="trash-icon">
    <Trash2 aria-hidden="true" class="delete-icon" />
  </template>
  <template id="sort-up-icon">
    <ArrowUp aria-hidden="true" class="sort-icon-svg" />
  </template>
  <template id="sort-down-icon">
    <ArrowDown aria-hidden="true" class="sort-icon-svg" />
  </template>
  <template id="sort-neutral-icon">
    <ArrowUpDown aria-hidden="true" class="sort-icon-svg" />
  </template>
</DashboardLayout>

<script>
  import { formatTimestamp } from '../utils/formatters';

  const columnCount = 7;

  const trashIconTemplate = document.getElementById('trash-icon') as HTMLTemplateElement | null;

  type Message = {
    Id: string;
    Name: string;
    Email: string;
    Phone: string;
    Message: string;
    Timestamp: string;
    IsSpam: boolean;
  };

  type FilterKey = 'all' | 'legit' | 'spam';
  type SortKey = 'name' | 'message' | 'email' | 'phone' | 'timestamp' | 'status';
  type SortDir = 'asc' | 'desc';

  let messages: Message[] = [];
  let filter: FilterKey = 'all';
  let sortKey: SortKey = 'timestamp';
  let sortDir: SortDir = 'desc';

  const collator = new Intl.Collator('de', { sensitivity: 'base', numeric: true });

  function cloneIcon(templateId: string): Node | null {
    const template = document.getElementById(templateId) as HTMLTemplateElement | null;
    return template?.content.firstElementChild?.cloneNode(true) ?? null;
  }

  function matchesFilter(message: Message): boolean {
    if (filter === 'spam') return message.IsSpam;
    if (filter === 'legit') return !message.IsSpam;
    return true;
  }

  function compareMessages(a: Message, b: Message): number {
    let result: number;
    switch (sortKey) {
      case 'name':
        result = collator.compare(a.Name, b.Name);
        break;
      case 'message':
        result = collator.compare(a.Message, b.Message);
        break;
      case 'email':
        result = collator.compare(a.Email, b.Email);
        break;
      case 'phone':
        result = collator.compare(a.Phone, b.Phone);
        break;
      case 'timestamp':
        result = new Date(a.Timestamp).getTime() - new Date(b.Timestamp).getTime();
        break;
      case 'status':
        result = Number(b.IsSpam) - Number(a.IsSpam);
        break;
    }
    return sortDir === 'asc' ? result : -result;
  }

  function renderEmptyRow(text: string) {
    const tbody = document.getElementById('message-table-body');
    if (!tbody) return;

    tbody.innerHTML = '';
    const tr = document.createElement('tr');
    const td = document.createElement('td');
    td.colSpan = columnCount;
    td.textContent = text;
    tr.appendChild(td);
    tbody.appendChild(tr);
  }

  function updateSummary() {
    const summary = document.getElementById('message-summary');
    if (!summary) return;
    if (messages.length === 0) {
      summary.textContent = '';
      return;
    }
    const spamCount = messages.filter((m) => m.IsSpam).length;
    summary.textContent =
      spamCount > 0
        ? `${messages.length} Nachrichten · ${spamCount} Spam`
        : `${messages.length} Nachrichten · kein Spam`;
  }

  function updateSortHeaders() {
    document.querySelectorAll<HTMLTableCellElement>('th[data-sort]').forEach((th) => {
      const key = th.dataset.sort as SortKey;
      const icon = th.querySelector('.sort-icon');
      if (!icon) return;
      icon.innerHTML = '';
      if (key === sortKey) {
        th.setAttribute('aria-sort', sortDir === 'asc' ? 'ascending' : 'descending');
        const activeIcon = cloneIcon(sortDir === 'asc' ? 'sort-up-icon' : 'sort-down-icon');
        if (activeIcon) icon.appendChild(activeIcon);
      } else {
        th.removeAttribute('aria-sort');
        const neutralIcon = cloneIcon('sort-neutral-icon');
        if (neutralIcon) icon.appendChild(neutralIcon);
      }
    });
  }

  function setupMessageCell(messageCell: HTMLElement, message: string) {
    const clamp = document.createElement('div');
    clamp.className = 'message-clamp';
    const text = document.createElement('span');
    text.className = 'message-text';
    text.textContent = message || '–';
    clamp.appendChild(text);
    messageCell.appendChild(clamp);

    const toggle = document.createElement('button');
    toggle.type = 'button';
    toggle.className = 'message-toggle';
    toggle.hidden = true;
    toggle.textContent = 'Mehr';
    toggle.addEventListener('click', () => {
      const expanded = clamp.classList.toggle('expanded');
      toggle.textContent = expanded ? 'Weniger' : 'Mehr';
    });
    clamp.appendChild(toggle);

    if (text.scrollHeight > text.clientHeight && message.length > 1) {
      toggle.hidden = false;
    }
  }

  function createRow(message: Message): HTMLTableRowElement {
    const tr = document.createElement('tr');
    tr.dataset.messageId = message.Id;

    const nameCell = document.createElement('td');
    nameCell.textContent = message.Name;
    tr.appendChild(nameCell);

    const messageCell = document.createElement('td');
    messageCell.className = 'message-cell';
    setupMessageCell(messageCell, message.Message);
    tr.appendChild(messageCell);

    const emailCell = document.createElement('td');
    emailCell.textContent = message.Email;
    tr.appendChild(emailCell);

    const phoneCell = document.createElement('td');
    phoneCell.textContent = message.Phone || '–';
    tr.appendChild(phoneCell);

    const timeCell = document.createElement('td');
    timeCell.className = 'nowrap';
    timeCell.textContent = formatTimestamp(message.Timestamp);
    tr.appendChild(timeCell);

    const statusCell = document.createElement('td');
    statusCell.className = 'status-cell';
    if (message.IsSpam) {
      const badge = document.createElement('span');
      badge.className = 'badge badge-spam';
      badge.textContent = 'Spam';
      statusCell.appendChild(badge);
    } else {
      const badge = document.createElement('span');
      badge.className = 'badge badge-ok';
      badge.textContent = 'OK';
      statusCell.appendChild(badge);
    }
    tr.appendChild(statusCell);

    const actionCell = document.createElement('td');
    actionCell.className = 'action-cell';
    const deleteButton = document.createElement('button');
    deleteButton.classList.add('icon-button');
    deleteButton.setAttribute('aria-label', 'Nachricht löschen');
    const iconClone = trashIconTemplate?.content.firstElementChild?.cloneNode(true);
    if (iconClone) {
      deleteButton.appendChild(iconClone);
    }
    deleteButton.addEventListener('click', () => deleteMessage(message.Id));
    actionCell.appendChild(deleteButton);
    tr.appendChild(actionCell);

    return tr;
  }

  function renderTable() {
    const tbody = document.getElementById('message-table-body');
    if (!tbody) return;

    const visible = messages.filter(matchesFilter).sort(compareMessages);
    tbody.innerHTML = '';

    if (visible.length === 0) {
      const emptyText =
        filter === 'spam'
          ? 'Keine Spam-Nachrichten vorhanden.'
          : filter === 'legit'
            ? 'Keine gesendeten Nachrichten vorhanden.'
            : 'Keine Nachrichten gefunden.';
      renderEmptyRow(emptyText);
      return;
    }

    visible.forEach((message) => {
      const tr = createRow(message);
      tbody.appendChild(tr);
      const clamp = tr.querySelector<HTMLElement>('.message-clamp');
      const toggle = tr.querySelector<HTMLButtonElement>('.message-toggle');
      const text = tr.querySelector<HTMLElement>('.message-text');
      if (clamp && toggle && text && toggle.hidden) {
        toggle.hidden = !(text.scrollHeight > text.clientHeight && text.textContent && text.textContent.length > 1);
      }
    });
  }

  async function deleteMessage(id: string) {
    const confirmed = window.confirm('Möchten Sie diese Nachricht wirklich löschen?');
    if (!confirmed) return;

    try {
      const res = await fetch(`/api/messages/${id}`, { method: 'DELETE' });
      if (!res.ok) {
        console.error('Failed to delete message', id, res.status);
        return;
      }

      messages = messages.filter((m) => m.Id !== id);
      updateSummary();
      renderTable();
    } catch (e) {
      console.error(e);
    }
  }

  async function loadMessages() {
    const tbody = document.getElementById('message-table-body');
    if (!tbody) return;

    try {
      const res = await fetch('/api/messages');
      if (!res.ok) throw new Error(`Failed to load messages (${res.status})`);
      messages = await res.json();
      tbody.innerHTML = '';
      if (messages.length === 0) {
        renderEmptyRow('Keine Nachrichten gefunden.');
        updateSummary();
        return;
      }
      updateSummary();
      renderTable();
      updateSortHeaders();
    } catch (e) {
      console.error(e);
      tbody.innerHTML = '';
      const tr = document.createElement('tr');
      const td = document.createElement('td');
      td.colSpan = columnCount;
      td.className = 'error';
      td.textContent = 'Nachrichten konnten nicht geladen werden.';
      tr.appendChild(td);
      tbody.appendChild(tr);
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.sort-button').forEach((button) => {
    button.addEventListener('click', () => {
      const key = button.dataset.sort as SortKey;
      if (key === sortKey) {
        sortDir = sortDir === 'asc' ? 'desc' : 'asc';
      } else {
        sortKey = key;
        sortDir = key === 'timestamp' ? 'desc' : 'asc';
      }
      renderTable();
      updateSortHeaders();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.filter-button').forEach((button) => {
    button.addEventListener('click', () => {
      filter = (button.dataset.filter as FilterKey) ?? 'all';
      document.querySelectorAll<HTMLButtonElement>('.filter-button').forEach((btn) => {
        const active = btn === button;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', String(active));
      });
      renderTable();
    });
  });

  loadMessages();
</script>

<style>
  .dashboard-page {
    background-color: var(--auwasser);
    color: var(--taubenblau);
  }

  .message-table {
    min-width: 48rem;
  }

  .message-table th {
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .message-cell {
    white-space: pre-wrap;
    word-break: break-word;
    max-width: 22rem;
  }

  .message-clamp .message-text {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .message-clamp.expanded .message-text {
    -webkit-line-clamp: unset;
  }

  .message-toggle {
    margin-top: 0.25rem;
    padding: 0;
    border: none;
    background: none;
    font-family: inherit;
    font-size: inherit;
    font-weight: 600;
    color: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .nowrap {
    white-space: nowrap;
  }

  .actions-header,
  .action-cell {
    text-align: center;
    width: 5rem;
  }

  .sort-button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0;
    border: none;
    background: none;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    color: inherit;
    cursor: pointer;
  }

  .sort-button:hover {
    text-decoration: underline;
  }

  .sort-button:focus-visible {
    outline: 2px solid var(--schurwolle);
    outline-offset: 2px;
  }

  .sort-icon {
    display: inline-flex;
    align-items: center;
    opacity: 0.55;
  }

  th[aria-sort='ascending'] .sort-icon,
  th[aria-sort='descending'] .sort-icon {
    opacity: 1;
  }

  .sort-icon-svg {
    width: 1rem;
    height: 1rem;
    stroke: currentColor;
    fill: none;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .filter-group {
    display: inline-flex;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid rgba(0, 32, 73, 0.15);
  }

  .filter-button {
    border: none;
    background-color: var(--schurwolle);
    color: var(--taubenblau);
    padding: 0.5rem 1rem;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }

  .filter-button + .filter-button {
    border-left: 1px solid rgba(0, 32, 73, 0.15);
  }

  .filter-button:hover {
    background-color: var(--himmelblau);
  }

  .filter-button.is-active {
    background-color: var(--weidegruen);
    color: var(--schurwolle);
  }

  .filter-button:focus-visible {
    outline: 2px solid var(--taubenblau);
    outline-offset: -2px;
  }

  .message-summary {
    margin: 0;
    font-weight: 600;
  }

  .status-cell {
    white-space: nowrap;
  }

  .badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .badge-spam {
    background-color: #b00020;
    color: #ffffff;
  }

  .badge-ok {
    background-color: var(--himmelblau);
    color: var(--schwarz);
  }

  @media (max-width: 600px) {
    .message-table th,
    .message-table td {
      font-size: 0.875rem;
    }

    .message-cell {
      max-width: 16rem;
    }
  }
</style>