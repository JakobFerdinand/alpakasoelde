---
import type { ImageMetadata } from 'astro';
import GalleryProduct from './gallery/GalleryProduct.astro';
import GalleryStory from './gallery/GalleryStory.astro';

export type GalleryVariant = 'product' | 'story';

export interface GallerySlide {
  /** Statically imported image (astro:assets metadata). Required. */
  src: ImageMetadata;
  /** REQUIRED, specific German alt text (no generic farm boilerplate). */
  alt: string;
  /** Short caption line; product: below stage, story: scrim overlay. */
  caption?: string;
  /** 1–2 sentences, product variant only (rendered under the title). */
  description?: string;
  /** Badge chip text, e.g. „Neu", „Bestseller" — product variant only. */
  badge?: string;
}

export interface Props {
  slides: GallerySlide[];
  variant?: GalleryVariant;
  id?: string;
  autoplay?: boolean;
  intervalMs?: number;
  loop?: boolean | 'wrap-buttons';
  showThumbnails?: boolean;
  lightbox?: boolean;
}

const {
  slides,
  variant = 'product',
  id,
  autoplay = variant === 'story',
  intervalMs = 6000,
  loop = 'wrap-buttons',
  showThumbnails = true,
  lightbox = true,
} = Astro.props as Props;

if (import.meta.env.DEV) {
  if (slides.length < 2) {
    console.warn(`[Slideshow] Mindestens zwei „slides“ erwartet, erhalten: ${slides.length}.`);
  }
  if (id && !/^[a-z][a-z0-9-]*$/.test(id)) {
    console.warn(`[Slideshow] „id“ „${id}“ entspricht nicht dem Muster /^[a-z][a-z0-9-]*$/.`);
  }
  if (loop !== 'wrap-buttons') {
    throw new Error(`[Slideshow] Nur loop='wrap-buttons' ist implementiert, erhalten: ${String(loop)}.`);
  }
  if (variant === 'story') {
    for (const slide of slides) {
      if (slide.badge) console.warn('[Slideshow] „badge“ wird in variant="story" ignoriert.');
      if (slide.description) console.warn('[Slideshow] „description“ wird in variant="story" ignoriert.');
    }
  }
}
---

{variant === 'story' ? (
  <GalleryStory slides={slides} id={id} autoplay={autoplay} intervalMs={intervalMs} />
) : (
  <GalleryProduct slides={slides} id={id} showThumbnails={showThumbnails} lightbox={lightbox} />
)}
