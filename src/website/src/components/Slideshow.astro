---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SlideshowChevron from './SlideshowChevron.astro';

export interface StorySlide {
  src: ImageMetadata;
  alt: string;
  kicker?: string;
  title?: string;
  text?: string;
  focal?: string;
}

interface Props {
  slides: StorySlide[];
  label: string;
  eyebrow?: string;
}

const { slides, label, eyebrow } = Astro.props;

const intervalMs = 7000;
---

<section
  class="story"
  data-js="false"
  data-interval={intervalMs}
  style={`--interval-ms:${intervalMs}ms`}
  role="region"
  aria-roledescription="Karussell"
  aria-label={label}
>
  {eyebrow && (
    <header class="story-header">
      <p class="story-eyebrow">{eyebrow}</p>
    </header>
  )}

  <div class="deck-wrap">
    <button class="deck-nav deck-prev" type="button" aria-label="Vorheriges Bild">
      <SlideshowChevron direction="prev" />
    </button>

    <ul
      class="deck"
      tabindex="0"
      aria-label="Bildstreifen – wischen oder mit den Pfeiltasten bewegen"
    >
      {slides.map((slide, i) => (
        <li
          class="slide"
          data-state={i === 0 ? 'active' : 'idle'}
          role="group"
          aria-roledescription="Folie"
          aria-label={`Bild ${i + 1} von ${slides.length}`}
        >
          <figure class="slide-card">
            <button class="slide-media" type="button" disabled aria-haspopup="dialog">
              <Image
                src={slide.src}
                alt={slide.alt}
                width={slide.src.width}
                height={slide.src.height}
                sizes="(min-width: 768px) min(72%, 47.5rem), calc(100vw - 4rem)"
                widths={[640, 960, 1280]}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                decoding="async"
                style={slide.focal ? `object-position:${slide.focal}` : undefined}
              />
              <span class="media-zoom" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="20"
                  height="20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="11" cy="11" r="7"></circle>
                  <path d="m21 21-4.3-4.3"></path>
                  <path d="M11 8v6M8 11h6"></path>
                </svg>
              </span>
              <span class="sr-only">{' – Bild groß anzeigen'}</span>
            </button>
            {(slide.kicker || slide.title || slide.text) && (
              <figcaption class="slide-caption">
                {slide.kicker && <p class="caption-kicker">{slide.kicker}</p>}
                {slide.title && <p class="caption-title">{slide.title}</p>}
                {slide.text && <p class="caption-text">{slide.text}</p>}
              </figcaption>
            )}
          </figure>
        </li>
      ))}
    </ul>

    <button class="deck-nav deck-next" type="button" aria-label="Nächstes Bild">
      <SlideshowChevron direction="next" />
    </button>
  </div>

  <div class="story-dots" role="group" aria-label="Direktnavigation">
    {slides.map((_, i) => (
      <button
        class="story-dot"
        type="button"
        aria-label={`Zu Bild ${i + 1} springen`}
        aria-current={i === 0 ? 'true' : undefined}
      >
        <span class="dot-fill"></span>
      </button>
    ))}
  </div>

  <p class="sr-only" role="status" data-slide-status></p>
</section>

<dialog class="lightbox" aria-label="Bildansicht" data-lightbox>
  <figure class="lb-figure">
    <div class="lb-media">
      <img class="lb-img" src="" alt="" />
    </div>
    <figcaption class="lb-caption">
      <p class="caption-kicker" data-lb-kicker></p>
      <p class="caption-title" data-lb-title></p>
      <p class="caption-text" data-lb-text></p>
    </figcaption>
  </figure>
  <p class="sr-only" role="status" data-lb-status></p>
  <p class="lb-count" aria-hidden="true" data-lb-count></p>
  <button class="lb-nav lb-prev" type="button" aria-label="Vorheriges Bild">
    <SlideshowChevron direction="prev" />
  </button>
  <button class="lb-nav lb-next" type="button" aria-label="Nächstes Bild">
    <SlideshowChevron direction="next" />
  </button>
  <button class="lb-close" type="button" aria-label="Schließen">
    <svg
      viewBox="0 0 24 24"
      width="20"
      height="20"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M18 6 6 18M6 6l12 12"></path>
    </svg>
  </button>
</dialog>

<script>
  const REDUCED = matchMedia('(prefers-reduced-motion: reduce)');
  const FINE_POINTER = matchMedia('(hover: hover) and (pointer: fine)');

  // What the lightbox needs from each slide, read and trimmed once at init
  // instead of re-querying the caption DOM on every open or step.
  interface LightboxSlide {
    img: HTMLImageElement | null;
    alt: string;
    kicker: string;
    title: string;
    text: string;
    hasCaption: boolean;
  }

  // All lightbox parts collected once at init; a single missing part means
  // the lightbox is not mounted at all rather than half-mounted.
  interface LightboxElements {
    dlg: HTMLElement;
    lbFig: HTMLElement;
    lbImg: HTMLImageElement;
    lbCap: HTMLElement;
    lbClose: HTMLButtonElement;
    lbPrev: HTMLButtonElement;
    lbNext: HTMLButtonElement;
    lbKicker: HTMLElement;
    lbTitle: HTMLElement;
    lbText: HTMLElement;
    lbCount: HTMLElement;
    lbStatus: HTMLElement;
  }

  // What the lightbox may ask of the deck: the slide elements, the way to
  // stop the deck's autoplay, and a no-animation jump for the restoration
  // after close.
  interface DeckHandle {
    slides: HTMLElement[];
    stopAutoplay: () => void;
    showSlide: (index: number) => void;
  }

  for (const story of document.querySelectorAll<HTMLElement>('.story')) {
    initStory(story);
  }

  // Deck and lightbox both wrap around in either direction; fold any
  // out-of-range index back into 0..length-1.
  function wrap(index: number, length: number) {
    return (index + length) % length;
  }

  function initStory(story: HTMLElement) {
    const deck = story.querySelector<HTMLElement>('.deck');
    const statusEl = story.querySelector<HTMLElement>('[data-slide-status]');
    if (!deck || !statusEl) return;

    const deckHandle = initDeck(story, deck, statusEl);
    // All deck behaviour (autoplay, controls, tracking) is live; the flag
    // does not depend on the lightbox being found.
    story.dataset.js = 'true';

    const lb = findLightbox(story);
    if (!lb) return;

    const openButtons = [...story.querySelectorAll<HTMLButtonElement>('.slide-media')];
    const slideData = readLightboxSlides(deckHandle.slides);

    // The open controls are disabled in markup so no-JS users never get a
    // dead button; unlock them only once the lightbox is up.
    for (const btn of openButtons) btn.disabled = false;

    initLightbox(lb, deckHandle, openButtons, slideData);
  }

  // Resolve the lightbox sibling and every part the script touches; return
  // null when one of them is missing.
  function findLightbox(story: HTMLElement): LightboxElements | null {
    const dlg = story.nextElementSibling;
    if (!(dlg instanceof HTMLElement) || !dlg.hasAttribute('data-lightbox')) return null;
    const lbFig = dlg.querySelector<HTMLElement>('.lb-figure');
    const lbImg = dlg.querySelector<HTMLImageElement>('.lb-img');
    const lbCap = dlg.querySelector<HTMLElement>('.lb-caption');
    const lbClose = dlg.querySelector<HTMLButtonElement>('.lb-close');
    const lbPrev = dlg.querySelector<HTMLButtonElement>('.lb-prev');
    const lbNext = dlg.querySelector<HTMLButtonElement>('.lb-next');
    const lbKicker = dlg.querySelector<HTMLElement>('[data-lb-kicker]');
    const lbTitle = dlg.querySelector<HTMLElement>('[data-lb-title]');
    const lbText = dlg.querySelector<HTMLElement>('[data-lb-text]');
    const lbCount = dlg.querySelector<HTMLElement>('[data-lb-count]');
    const lbStatus = dlg.querySelector<HTMLElement>('[data-lb-status]');
    if (
      !lbFig ||
      !lbImg ||
      !lbCap ||
      !lbClose ||
      !lbPrev ||
      !lbNext ||
      !lbKicker ||
      !lbTitle ||
      !lbText ||
      !lbCount ||
      !lbStatus
    ) {
      return null;
    }
    return {
      dlg,
      lbFig,
      lbImg,
      lbCap,
      lbClose,
      lbPrev,
      lbNext,
      lbKicker,
      lbTitle,
      lbText,
      lbCount,
      lbStatus,
    };
  }

  function readLightboxSlides(slides: HTMLElement[]): LightboxSlide[] {
    return slides.map((slide) => {
      const img = slide.querySelector<HTMLImageElement>('.slide-media img');
      const caption = slide.querySelector<HTMLElement>('.slide-caption');
      const kicker = caption?.querySelector('.caption-kicker') ?? null;
      const title = caption?.querySelector('.caption-title') ?? null;
      const text = caption?.querySelector('.caption-text') ?? null;
      // hasCaption mirrors the presence of the caption's source elements,
      // not the emptiness of their text.
      return {
        img,
        alt: img?.alt ?? '',
        kicker: kicker?.textContent?.trim() ?? '',
        title: title?.textContent?.trim() ?? '',
        text: text?.textContent?.trim() ?? '',
        hasCaption: kicker !== null || title !== null || text !== null,
      };
    });
  }

  function initDeck(story: HTMLElement, deck: HTMLElement, statusEl: HTMLElement): DeckHandle {
    const slides = [...deck.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...story.querySelectorAll<HTMLButtonElement>('.story-dot')];
    const prevBtn = story.querySelector<HTMLButtonElement>('.deck-prev');
    const nextBtn = story.querySelector<HTMLButtonElement>('.deck-next');
    const intervalMs = Number(story.dataset.interval);

    let active = 0;
    let autoState: 'idle' | 'running' | 'paused' | 'stopped' = 'idle';
    let timer: number | undefined;
    let onscreen = false;
    let hovered = false;
    let focused = false;
    let rafPending = false;
    let programmaticScroll = false;
    let programmaticScrollTimer: number | undefined;
    let touchX: number | null = null;
    let deckTouches = 0;

    const midpoints = () => slides.map((s) => s.offsetLeft + s.offsetWidth / 2);

    function setActive(i: number) {
      if (i === active || !slides[i]) return;
      active = i;
      slides.forEach((s, j) => {
        s.dataset.state = j === i ? 'active' : 'idle';
      });
      dots.forEach((d, j) => {
        if (j === i) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
    }

    function syncActive() {
      const mids = midpoints();
      const center = deck.scrollLeft + deck.clientWidth / 2;
      let best = 0;
      mids.forEach((m, i) => {
        if (Math.abs(m - center) < Math.abs(mids[best] - center)) best = i;
      });
      setActive(best);
    }

    deck.addEventListener(
      'scroll',
      () => {
        if (programmaticScroll) {
          // In-flight goTo: no active-slide changes until the scroll settles.
          window.clearTimeout(programmaticScrollTimer);
          programmaticScrollTimer = window.setTimeout(endProgrammaticScroll, 200);
          return;
        }
        if (rafPending) return;
        rafPending = true;
        requestAnimationFrame(() => {
          rafPending = false;
          syncActive();
        });
      },
      { passive: true },
    );
    deck.addEventListener('scrollend', endProgrammaticScroll);

    function endProgrammaticScroll() {
      if (!programmaticScroll) {
        syncActive();
        return;
      }
      programmaticScroll = false;
      window.clearTimeout(programmaticScrollTimer);
      syncActive();
    }

    function breakProgrammaticScroll() {
      if (!programmaticScroll) return;
      programmaticScroll = false;
      window.clearTimeout(programmaticScrollTimer);
    }

    function scrollToSlide(i: number, smooth: boolean) {
      deck.scrollTo({
        left: midpoints()[i] - deck.clientWidth / 2,
        behavior: smooth && !REDUCED.matches ? 'smooth' : 'auto',
      });
    }

    function goTo(i: number) {
      programmaticScroll = true;
      window.clearTimeout(programmaticScrollTimer);
      programmaticScrollTimer = window.setTimeout(endProgrammaticScroll, 700);
      scrollToSlide(i, true);
      setActive(i);
    }

    function eligible() {
      return (
        onscreen &&
        !document.hidden &&
        !REDUCED.matches &&
        !hovered &&
        !focused &&
        autoState !== 'stopped'
      );
    }

    function refreshAutoplay() {
      window.clearTimeout(timer);
      if (autoState !== 'stopped') autoState = eligible() ? 'running' : 'paused';
      story.dataset.autoplay = autoState;
      if (autoState === 'running') timer = window.setTimeout(advance, intervalMs);
    }

    function pause() {
      if (autoState !== 'running') return;
      autoState = 'paused';
      window.clearTimeout(timer);
      story.dataset.autoplay = 'paused';
    }

    function stopAutoplay() {
      if (autoState === 'stopped') return;
      autoState = 'stopped';
      window.clearTimeout(timer);
      story.dataset.autoplay = 'stopped';
    }

    function advance() {
      goTo(wrap(active + 1, slides.length));
      arm();
    }

    function arm() {
      window.clearTimeout(timer);
      if (eligible()) timer = window.setTimeout(advance, intervalMs);
    }

    function announce(i: number) {
      if (autoState === 'stopped') statusEl.textContent = `Bild ${i + 1} von ${slides.length}`;
    }

    function step(delta: number) {
      const next = wrap(active + delta, slides.length);
      goTo(next);
      announce(next);
    }

    prevBtn?.addEventListener('click', () => {
      stopAutoplay();
      step(-1);
    });
    nextBtn?.addEventListener('click', () => {
      stopAutoplay();
      step(1);
    });
    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        stopAutoplay();
        goTo(i);
        announce(i);
      }),
    );
    deck.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      stopAutoplay();
      step(e.key === 'ArrowLeft' ? -1 : 1);
    });

    deck.addEventListener('pointerdown', breakProgrammaticScroll);
    // Ken Burns is paused while the visitor drags/touch-scrolls the deck (§7);
    // the attribute lives on the story root (`.story[data-dragging]` selector).
    function setDragging(on: boolean) {
      if (on) story.dataset.dragging = '';
      else delete story.dataset.dragging;
    }
    deck.addEventListener(
      'touchstart',
      (e) => {
        breakProgrammaticScroll();
        deckTouches = e.touches.length;
        setDragging(true);
        touchX = e.touches[0]?.clientX ?? null;
      },
      { passive: true },
    );
    deck.addEventListener(
      'touchend',
      (e) => {
        deckTouches = e.touches.length;
        if (deckTouches === 0) setDragging(false);
        if (touchX === null) return;
        const dx = Math.abs(e.changedTouches[0].clientX - touchX);
        touchX = null;
        if (dx > (slides[0]?.offsetWidth ?? deck.clientWidth) * 0.3) stopAutoplay();
      },
      { passive: true },
    );
    deck.addEventListener(
      'touchcancel',
      (e) => {
        deckTouches = e.touches.length;
        if (deckTouches === 0) setDragging(false);
        else setDragging(true);
        touchX = null;
      },
      { passive: true },
    );
    deck.addEventListener('scrollend', () => setDragging(false));
    deck.addEventListener('wheel', breakProgrammaticScroll, { passive: true });

    story.addEventListener('mouseenter', () => {
      if (!FINE_POINTER.matches) return;
      hovered = true;
      refreshAutoplay();
    });
    story.addEventListener('mouseleave', () => {
      hovered = false;
      refreshAutoplay();
    });
    story.addEventListener('focusin', () => {
      focused = true;
      refreshAutoplay();
    });
    story.addEventListener('focusout', (e: FocusEvent) => {
      if (e.relatedTarget instanceof Node && story.contains(e.relatedTarget)) return;
      focused = false;
      refreshAutoplay();
    });
    story.addEventListener('pointerdown', pause);
    story.addEventListener('pointerup', refreshAutoplay);
    story.addEventListener('pointercancel', refreshAutoplay);
    document.addEventListener('visibilitychange', refreshAutoplay);

    new IntersectionObserver(
      (entries) => {
        onscreen = entries.some((entry) => entry.isIntersecting);
        refreshAutoplay();
      },
      { threshold: 0.4 },
    ).observe(story);

    return {
      slides,
      stopAutoplay,
      // Jump without animation and mark the slide active; used when the
      // lightbox closes so the deck reflects the last-shown image.
      showSlide(index: number) {
        breakProgrammaticScroll();
        if (slides[index]) {
          scrollToSlide(index, false);
          setActive(index);
        }
      },
    };
  }

  function initLightbox(
    lb: LightboxElements,
    deckHandle: DeckHandle,
    openButtons: HTMLButtonElement[],
    slideData: LightboxSlide[],
  ) {
    const {
      dlg,
      lbImg,
      lbFig,
      lbCap,
      lbClose,
      lbPrev,
      lbNext,
      lbKicker,
      lbTitle,
      lbText,
      lbCount,
      lbStatus,
    } = lb;
    const hasNativeDialog =
      typeof HTMLDialogElement !== 'undefined' && dlg instanceof HTMLDialogElement;

    let lbIndex = 0;
    let transitionNamed: HTMLElement[] = [];
    // True when the lightbox's last touch was a drag/pinch rather than a tap;
    // suppresses the click browsers can fire after such gestures so pinch-zoom
    // and swipe navigation never close the lightbox.
    let lbGestureMoved = false;
    let touchX: number | null = null;
    let touchY: number | null = null;

    function lockScroll(lock: boolean) {
      const html = document.documentElement;
      if (!lock) {
        html.style.overflow = '';
        html.style.paddingRight = '';
        return;
      }
      const gap = window.innerWidth - html.clientWidth;
      html.style.overflow = 'hidden';
      if (gap > 0) html.style.paddingRight = `${gap}px`;
    }

    function clearTransitionNames() {
      transitionNamed.forEach((el) => {
        el.style.viewTransitionName = '';
      });
      transitionNamed = [];
    }

    // One helper for the open and close zoom view transitions: `from` carries
    // the `story-zoom` name in the old state, `to` takes it over in the new
    // one (duplicate names abort the transition); without the API, or under
    // reduced motion, the change runs plainly.
    function withZoomTransition(from: HTMLElement, to: HTMLElement, commit: () => void) {
      const doc = document as Document & {
        startViewTransition?(callback: () => void): { finished: Promise<void> };
      };
      if (!doc.startViewTransition || REDUCED.matches) {
        commit();
        return;
      }
      from.style.viewTransitionName = 'story-zoom';
      transitionNamed = [from, to];
      doc
        .startViewTransition(() => {
          from.style.viewTransitionName = '';
          to.style.viewTransitionName = 'story-zoom';
          commit();
        })
        .finished.finally(clearTransitionNames);
    }

    function restoreAfterClose() {
      lockScroll(false);
      // The deck must reflect the image last shown in the lightbox: jump
      // there without animation and hand focus to its open control.
      deckHandle.showSlide(lbIndex);
      openButtons[lbIndex]?.focus();
    }

    function lightboxSrc(img: HTMLImageElement) {
      const srcset = img.getAttribute('srcset') ?? '';
      const candidates = srcset
        .split(',')
        .map((part) => part.trim().split(/\s+/))
        .filter((parts) => parts.length > 1 && /^\d+w$/.test(parts[1]))
        .map((parts) => ({ url: parts[0], width: Number.parseInt(parts[1], 10) }))
        .sort((a, b) => a.width - b.width);
      if (candidates.length === 0) return img.currentSrc || img.src;
      // Mirror the browser's w-descriptor selection for sizes="100vw" so
      // preload() fetches exactly what the lightbox will load.
      const target = window.innerWidth * (window.devicePixelRatio || 1);
      return (candidates.find((c) => c.width >= target) ?? candidates[candidates.length - 1]).url;
    }

    function setLbContent(i: number) {
      const slide = slideData[i];
      if (!slide?.img) return;

      const srcset = slide.img.getAttribute('srcset') ?? '';
      lbImg.sizes = '100vw';
      if (srcset) lbImg.srcset = srcset;
      lbImg.src = lightboxSrc(slide.img);
      lbImg.alt = slide.alt;

      lbKicker.textContent = slide.kicker;
      lbTitle.textContent = slide.title;
      lbText.textContent = slide.text;
      lbCap.classList.toggle('is-empty', !slide.hasCaption);

      lbCount.textContent = `${i + 1} / ${slideData.length}`;
      lbStatus.textContent = `Bild ${i + 1} von ${slideData.length}`;
    }

    function preload(i: number) {
      const img = slideData[i]?.img;
      if (!img) return;
      new Image().src = lightboxSrc(img);
    }

    function onFallbackKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        e.preventDefault();
        closeLightbox();
        return;
      }
      if (e.key !== 'Tab') return;
      const focusables = [...dlg.querySelectorAll<HTMLElement>('button, [href]')];
      if (focusables.length === 0 || document.activeElement === null) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    function openLightbox(i: number) {
      const fig = deckHandle.slides[i]?.querySelector<HTMLElement>('.slide-card');
      deckHandle.stopAutoplay();

      setLbContent(i);
      lbIndex = i;
      preload(wrap(i + 1, slideData.length));
      preload(wrap(i - 1, slideData.length));

      lockScroll(true);

      if (!hasNativeDialog) {
        dlg.setAttribute('role', 'dialog');
        dlg.setAttribute('aria-modal', 'true');
        dlg.classList.add('is-open');
        document.addEventListener('keydown', onFallbackKeydown);
        lbClose.focus();
        return;
      }

      const box = dlg as HTMLDialogElement;
      if (fig) {
        // Old state: only the slide card carries the name; the lightbox
        // figure takes it over in the new state.
        withZoomTransition(fig, lbFig, () => box.showModal());
      } else {
        box.showModal();
      }
    }

    function lbStep(delta: number) {
      if (slideData.length < 2) return;
      lbIndex = wrap(lbIndex + delta, slideData.length);
      setLbContent(lbIndex);
      preload(wrap(lbIndex + delta, slideData.length));
    }

    function closeLightbox() {
      document.removeEventListener('keydown', onFallbackKeydown);
      if (!hasNativeDialog) {
        dlg.classList.remove('is-open');
        restoreAfterClose();
        return;
      }
      const box = dlg as HTMLDialogElement;
      const fig = deckHandle.slides[lbIndex]?.querySelector<HTMLElement>('.slide-card');
      if (fig) {
        // Reverse of open: old state = lightbox figure, new state = slide card.
        withZoomTransition(lbFig, fig, () => box.close());
      } else {
        box.close();
      }
    }

    openButtons.forEach((btn, i) => btn.addEventListener('click', () => openLightbox(i)));
    lbClose.addEventListener('click', closeLightbox);
    lbPrev.addEventListener('click', () => lbStep(-1));
    lbNext.addEventListener('click', () => lbStep(1));
    // A lightbox tap on anything but the photo, the caption or a control
    // button is a backdrop tap; the (opaque, fullscreen) dialog has no visible
    // ::backdrop of its own.
    dlg.addEventListener('click', (e) => {
      if (lbGestureMoved) {
        lbGestureMoved = false;
        return;
      }
      const t = e.target;
      if (t instanceof Element && t !== dlg && t.closest('button, .lb-media img, .lb-caption')) {
        return;
      }
      closeLightbox();
    });
    // Reset here even for touch/pen: pointerdown fires before touchstart,
    // which sets the flag again for multi-touch gestures.
    dlg.addEventListener('pointerdown', () => {
      lbGestureMoved = false;
    });
    dlg.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        lbStep(-1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        lbStep(1);
      }
    });
    dlg.addEventListener(
      'touchstart',
      (e: TouchEvent) => {
        if (e.touches.length > 1) {
          // Multi-touch (pinch-zoom): forget the stale swipe start so lifting
          // one finger cannot flip to another image.
          touchX = null;
          touchY = null;
          lbGestureMoved = true;
          return;
        }
        lbGestureMoved = false;
        touchX = e.touches[0]?.clientX ?? null;
        touchY = e.touches[0]?.clientY ?? null;
      },
      { passive: true },
    );
    dlg.addEventListener(
      'touchend',
      (e: TouchEvent) => {
        if (touchX === null || touchY === null) return;
        const t = e.changedTouches[0];
        const dx = t ? t.clientX - touchX : 0;
        const dy = t ? t.clientY - touchY : 0;
        if (e.changedTouches.length > 1 || Math.abs(dx) > 8 || Math.abs(dy) > 8) {
          lbGestureMoved = true;
        }
        touchX = null;
        touchY = null;
        if (Math.abs(dx) > 48 && Math.abs(dx) > 2 * Math.abs(dy)) lbStep(dx < 0 ? 1 : -1);
      },
      { passive: true },
    );
    dlg.addEventListener('touchcancel', () => {
      lbGestureMoved = true;
      touchX = null;
      touchY = null;
    });
    dlg.addEventListener('close', () => {
      document.removeEventListener('keydown', onFallbackKeydown);
      restoreAfterClose();
    });
  }
</script>

