---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface SlideshowImage {
  src: ImageMetadata;
  alt: string;
}

export interface Props {
  images: SlideshowImage[];
  label?: string;
  autoplay?: boolean;
  interval?: number;
  aspect?: "auto" | `${number} / ${number}`;
}

const {
  images,
  label = "Fotogalerie",
  autoplay = true,
  interval: rawInterval = 5000,
  aspect = "auto",
} = Astro.props;

const uid = Math.random().toString(36).slice(2, 8);
const interval = Math.min(15000, Math.max(2000, rawInterval));

let ratioW: number;
let ratioH: number;
if (aspect === "auto") {
  const tallest = images.reduce((a, b) =>
    b.src.height / b.src.width > a.src.height / a.src.width ? b : a
  );
  ratioW = tallest.src.width;
  ratioH = tallest.src.height;
} else {
  [ratioW, ratioH] = aspect.split(" / ").map(Number);
}

const sizesAttr = `(min-width: 768px) ${Math.ceil((((512 * ratioW) / ratioH) * 1.15) / 16) * 16}px, 100vw`;
---

<section
  class="slideshow"
  data-slideshow
  data-autoplay={autoplay ? "" : undefined}
  data-interval={interval}
  role="region"
  aria-roledescription="Karussell"
  aria-label={label}
  style={`--ss-ratio-w:${ratioW}; --ss-ratio-h:${ratioH};`}
>
  <div class="slideshow__stage">
    <button
      class="slideshow__arrow slideshow__arrow--prev"
      type="button"
      data-dir="-1"
      aria-label="Vorheriges Bild"
      aria-controls={`ss-track-${uid}`}
      disabled
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m15 18-6-6 6-6"></path>
      </svg>
    </button>

    <div class="slideshow__frame">
      <ul class="slideshow__track" tabindex="0" id={`ss-track-${uid}`}>
        {images.map((img, i) => (
          <li class="slideshow__slide">
            <Image
              src={img.src}
              alt={img.alt}
              width={img.src.width}
              height={img.src.height}
              widths={[400, 800, 1200].filter((w) => w <= img.src.width)}
              sizes={sizesAttr}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : undefined}
              decoding="async"
              class="slideshow__img"
            />
          </li>
        ))}
      </ul>
    </div>

    <button
      class="slideshow__arrow slideshow__arrow--next"
      type="button"
      data-dir="1"
      aria-label="Nächstes Bild"
      aria-controls={`ss-track-${uid}`}
      disabled
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </button>
  </div>

  <div class="slideshow__progress" aria-hidden="true"></div>

  <div class="slideshow__footer">
    <div class="slideshow__dots" role="group" aria-label="Bildauswahl">
      {images.map((_, i) => (
        <button
          type="button"
          class="slideshow__dot"
          aria-label={`Zu Bild ${i + 1}`}
          aria-current={i === 0 ? "true" : undefined}
          disabled
        />
      ))}
    </div>
    <p class="sr-only" aria-live="polite" data-slideshow-status></p>
  </div>
</section>

<script>
  const REDUCED = matchMedia("(prefers-reduced-motion: reduce)");
  const SETTLE_MS = 140;

  for (const root of document.querySelectorAll<HTMLElement>("[data-slideshow]")) init(root);

  function init(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>(".slideshow__track")!;
    const slides = [...track.children] as HTMLElement[];
    const prev = root.querySelector<HTMLButtonElement>('[data-dir="-1"]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-dir="1"]')!;
    const dots = [...root.querySelectorAll<HTMLButtonElement>(".slideshow__dot")];
    const status = root.querySelector<HTMLElement>("[data-slideshow-status]")!;
    const n = slides.length;
    const interval = Number(root.dataset.interval ?? 5000);
    const auto = root.hasAttribute("data-autoplay");
    const s = { i: 0, stopped: false, paused: false, gesture: false, inView: true, timer: 0 };

    const canRun = () =>
      auto && !s.stopped && !s.paused && !s.gesture && s.inView && !document.hidden && !REDUCED.matches;
    const arm = () => {
      clearTimeout(s.timer);
      if (canRun()) s.timer = window.setTimeout(tick, interval);
    };
    const stop = () => {
      s.stopped = true;
      clearTimeout(s.timer);
    };

    function goTo(i: number, announce = false) {
      const target = Math.max(0, Math.min(n - 1, i));
      if (target === s.i && announce) return;
      s.i = target;
      track.scrollTo({
        left: slides[s.i].offsetLeft - track.offsetLeft,
        behavior: REDUCED.matches ? "auto" : "smooth",
      });
      sync(announce);
    }
    function jumpTo(i: number) {
      s.i = i;
      track.scrollTo({ left: slides[i].offsetLeft - track.offsetLeft, behavior: "auto" });
      sync(false);
    }
    function sync(announce: boolean) {
      prev.disabled = s.i === 0;
      next.disabled = s.i === n - 1;
      dots.forEach((d, k) => {
        if (k === s.i) d.setAttribute("aria-current", "true");
        else d.removeAttribute("aria-current");
      });
      if (announce) status.textContent = `Bild ${s.i + 1} von ${n}`;
    }
    const indexFromScroll = () =>
      Math.max(0, Math.min(n - 1, Math.round(track.scrollLeft / track.clientWidth)));

    let settleTimer = 0;
    let downScroll = 0;
    const settleGesture = () => {
      s.gesture = false;
      if (Math.abs(track.scrollLeft - downScroll) > track.clientWidth / 3) stop();
      else sync(false);
      arm();
    };

    root.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-dir], .slideshow__dot");
      if (!btn || btn.disabled) return;
      stop();
      if (btn.dataset.dir) goTo(s.i + Number(btn.dataset.dir), true);
      else goTo(dots.indexOf(btn), true);
    });
    const STEPS: Record<string, number> = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };
    track.addEventListener("keydown", (e) => {
      const step = STEPS[e.key];
      if (step === undefined && e.key !== "Home" && e.key !== "End") return;
      e.preventDefault();
      stop();
      if (e.key === "Home") goTo(0, true);
      else if (e.key === "End") goTo(n - 1, true);
      else goTo(s.i + step, true);
    });
    track.addEventListener("pointerdown", () => {
      s.gesture = true;
      downScroll = track.scrollLeft;
      clearTimeout(settleTimer);
      clearTimeout(s.timer);
    });
    track.addEventListener("pointerup", () => {
      settleTimer = window.setTimeout(settleGesture, SETTLE_MS);
    });
    track.addEventListener("pointercancel", settleGesture);
    track.addEventListener(
      "wheel",
      () => {
        s.gesture = true;
        clearTimeout(settleTimer);
        settleTimer = window.setTimeout(settleGesture, SETTLE_MS);
      },
      { passive: true }
    );

    const settledScroll = () => {
      if (!s.gesture) {
        s.i = indexFromScroll();
        sync(false);
      }
    };
    if ("onscrollend" in HTMLElement.prototype)
      track.addEventListener("scrollend", settledScroll);
    else
      track.addEventListener(
        "scroll",
        (() => {
          let t = 0;
          return () => {
            clearTimeout(t);
            t = window.setTimeout(settledScroll, 120);
          };
        })(),
        { passive: true }
      );

    const setPaused = (p: boolean) => {
      s.paused = p;
      if (p) clearTimeout(s.timer);
      else arm();
    };
    root.addEventListener("pointerenter", () => setPaused(true));
    root.addEventListener("pointerleave", () => setPaused(false));
    root.addEventListener("focusin", () => setPaused(true));
    root.addEventListener("focusout", (e) => {
      if (!root.contains(e.relatedTarget as Node)) setPaused(false);
    });

    new IntersectionObserver(
      ([en]) => {
        s.inView = en.isIntersecting;
        if (en.isIntersecting) arm();
        else clearTimeout(s.timer);
      },
      { threshold: 0.5 }
    ).observe(root);
    document.addEventListener("visibilitychange", () =>
      document.hidden ? clearTimeout(s.timer) : arm()
    );
    REDUCED.addEventListener("change", () => (REDUCED.matches ? clearTimeout(s.timer) : arm()));
    addEventListener(
      "resize",
      () =>
        requestAnimationFrame(() => {
          s.i = indexFromScroll();
          sync(false);
        }),
      { passive: true }
    );

    function tick() {
      if (!canRun()) return;
      if (s.i === n - 1) jumpTo(0);
      else goTo(s.i + 1);
      arm();
    }

    for (const b of [prev, next, ...dots]) b.disabled = false;
    root.setAttribute("data-ready", "");
    sync(false);
    if (!REDUCED.matches) arm();
  }
</script>

<style>
  .slideshow {
    --frame-max-h: 32rem;
    inline-size: 100%;
  }

  .slideshow__frame {
    position: relative;
    inline-size: min(100%, calc(var(--frame-max-h) * var(--ss-ratio-w) / var(--ss-ratio-h)));
    margin-inline: auto;
    aspect-ratio: var(--ss-ratio-w) / var(--ss-ratio-h);
    background-color: var(--schurwolle);
  }

  .slideshow__track {
    display: flex;
    block-size: 100%;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scroll-behavior: smooth;
  }

  .slideshow[data-ready] .slideshow__track {
    scrollbar-width: none;
  }
  .slideshow[data-ready] .slideshow__track::-webkit-scrollbar {
    display: none;
  }

  .slideshow__slide {
    flex: 0 0 100%;
    min-inline-size: 0;
    display: flex;
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }

  .slideshow__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  .slideshow__stage {
    display: flex;
    align-items: center;
  }

  .slideshow__arrow {
    display: grid;
    place-items: center;
    inline-size: 56px;
    block-size: 56px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background-color: var(--taubenblau);
    color: var(--schurwolle);
    cursor: pointer;
    transition: background-color 150ms ease;
  }
  .slideshow__arrow:hover:not(:disabled) {
    background-color: color-mix(in srgb, var(--taubenblau) 85%, transparent);
    box-shadow: 0 0 0 2px var(--bluetenhonig);
  }
  .slideshow__arrow svg {
    inline-size: 28px;
    block-size: 28px;
  }
  .slideshow__arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .slideshow__arrow {
    display: none;
  }
  @media (min-width: 768px) {
    .slideshow__stage {
      gap: 0.75rem;
    }
    .slideshow__arrow {
      display: grid;
    }
  }
  @media (min-width: 1024px) {
    .slideshow__stage {
      position: relative;
      gap: 0;
    }
    .slideshow__arrow {
      position: absolute;
      top: 50%;
      translate: 0 -50%;
      z-index: 1;
    }
    .slideshow__arrow--prev {
      inset-inline-start: 0.75rem;
    }
    .slideshow__arrow--next {
      inset-inline-end: 0.75rem;
    }
  }

  .slideshow__footer {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }
  .slideshow__dot {
    inline-size: 44px;
    block-size: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }
  .slideshow__dot::before {
    content: "";
    inline-size: 8px;
    block-size: 8px;
    border-radius: 50%;
    background-color: var(--taubenblau);
    transition: scale 200ms ease;
  }
  .slideshow__dot[aria-current="true"]::before {
    inline-size: 12px;
    block-size: 12px;
    background-color: var(--bluetenhonig);
    border: 2px solid var(--taubenblau);
    scale: 1.15;
  }

  .slideshow__track:focus-visible,
  .slideshow__arrow:focus-visible,
  .slideshow__dot:focus-visible {
    outline: 3px solid var(--taubenblau);
    outline-offset: 2px;
  }
  @media (min-width: 1024px) {
    .slideshow__arrow:focus-visible {
      outline-color: var(--schurwolle);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slideshow *,
    .slideshow::before,
    .slideshow::after {
      transition: none !important;
      animation: none !important;
    }
    .slideshow__track {
      scroll-behavior: auto;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @supports (transition-behavior: allow-discrete) and (top: calc(1px * sign(1))) {
    .slideshow__arrow,
    .slideshow__dot {
      opacity: 1;
      translate: 0 0;
      transition:
        opacity 400ms ease,
        translate 400ms ease,
        background-color 150ms ease;
    }
    @starting-style {
      .slideshow[data-ready] .slideshow__arrow,
      .slideshow[data-ready] .slideshow__dot {
        opacity: 0;
        translate: 0 0.5rem;
      }
    }
  }

  .slideshow__progress {
    display: none;
  }
  @supports (animation-timeline: scroll()) {
    .slideshow {
      timeline-scope: --ss-timeline;
    }
    .slideshow__progress {
      display: block;
    }
    .slideshow__track {
      scroll-timeline: --ss-timeline x;
    }
    .slideshow__progress::after {
      content: "";
      display: block;
      block-size: 2px;
      background-color: var(--bluetenhonig);
      transform-origin: left;
      animation: ss-progress linear both;
      animation-timeline: --ss-timeline;
    }
    @keyframes ss-progress {
      from {
        scale: 0 1;
      }
      to {
        scale: 1 1;
      }
    }
  }

  /* ── Phase 3 (blocked until Baseline Newly Available): native CSS carousel ──
  @supports selector(::scroll-button(*)) and selector(::scroll-marker) {
    .slideshow__arrow, .slideshow__dots { display: none; }
    … ::scroll-button(left/right), ::scroll-marker, :target-current rules
      copied verbatim from feature/slideshow commit 16acbdf, token-fixed …
  }
  Trigger: stable Safari AND unflagged Firefox ship both pseudo-elements.
  Then: delete DOM-control branches in the script (§4), re-run checklist. ~0.5 d. */
</style>
