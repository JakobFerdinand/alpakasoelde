---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt?: string;
  backgroundPosition?: string;
}

const {
  image,
  alt = 'Alpakasölde Impression',
  backgroundPosition = 'center',
} = Astro.props as Props;
---

<section class="impression-break">
  <Image
    src={image}
    alt={alt}
    layout="full-width"
    class="impression-photo"
    style={`object-position: ${backgroundPosition}`}
  />
</section>

<style>
  .impression-break {
    position: relative;
    isolation: isolate;
    min-height: clamp(20rem, 90vh, 30rem);
    width: 100%;
    overflow: hidden;
  }

  /* The photo was a CSS background built from the raw import, so Sharp never
     saw it: the band shipped a full-resolution JPEG. As an `<Image>` it gets
     the usual srcset and webp treatment, and the alt text lives on the img
     itself instead of a `role="img"` wrapper with an sr-only caption. The
     framing stays in CSS: Astro's `position` prop is a Sharp crop gravity and
     rejects the percentage offsets these bands are framed with. */
  .impression-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .impression-break::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(50% 50% at 50% 50%, rgba(0, 0, 0, 0.12), transparent 60%);
    z-index: -1;
  }
</style>
