---
import { Image } from "astro:assets";
import Logo from "../images/AS_Gesamt_untereinander_Schurwolle.svg";
import heroImage from "../images/hero.jpg";
---

<section class="hero">
  <Image
    src={heroImage}
    alt="Alpakaherde auf der Weide der Alpakasölde in Frauenstein"
    layout="full-width"
    priority
    class="hero-photo"
  />
  <Image src={Logo} alt="Alpakasölde Logo" class="hero-image" />
  <h1 class="sr-only">Alpakasölde</h1>
  <p>Erlebe unvergessliche Momente mit unseren Alpakas in Frauenstein.</p>
  <a href="#kontakt" class="btn">Jetzt Alpaka-Tour buchen</a>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    margin-top: calc(-1 * var(--nav-height, 80px));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    color: var(--schurwolle);
    padding: calc(5rem + var(--nav-height, 80px)) 1rem 5rem;
  }

  /* The photo used to be a CSS background, which kept it out of Astro's image
     pipeline: no srcset, no webp, and invisible to the preload scanner even
     though it is the page's LCP element. */
  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  /* Was baked into `background-image` as a linear-gradient layer. */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.35);
    z-index: -1;
  }

  /* Scoped to the wordmark on purpose: a bare `.hero img` now also matches
     the background photo and would collapse it to the logo's size. */
  .hero-image {
    width: 16rem;
    height: 10rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .hero-image {
      width: 35rem;
      height: 15rem;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero p {
    font-size: 1.125rem;
    margin-bottom: 1.5rem;
  }
</style>
