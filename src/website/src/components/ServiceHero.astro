---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  imagePosition?: string;
  className?: string;
}

const {
  title,
  description,
  image,
  imageAlt,
  imagePosition = "center",
  className = "",
} = Astro.props;
---

<section class={`hero ${className}`}>
  <Image
    src={image}
    alt={imageAlt}
    layout="full-width"
    priority
    class="hero-photo"
    style={`object-position: ${imagePosition}`}
  />
  <div class="hero-content">
    <h1>{title}</h1>
    <p>{description}</p>
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    margin-top: calc(-1 * var(--nav-height, 80px));
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 32rem;
    overflow: hidden;
    color: var(--schurwolle);
    padding: calc(5rem + var(--nav-height, 80px)) 1rem 5rem;
  }

  /* The photo used to be a CSS background, which kept it out of Astro's image
     pipeline: no srcset, no webp, and invisible to the preload scanner even
     though it is the LCP element on every page using this hero. The framing
     stays in CSS (`object-position`): Astro's `position` prop is a Sharp crop
     gravity and rejects the percentage offsets these images are framed with. */
  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  /* Was baked into `background-image` as a linear-gradient layer. */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.35);
    z-index: -1;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 720px;
  }

  .hero h1 {
    margin: 0;
    font-size: 2rem;
  }

  .hero p {
    font-size: 1.125rem;
    margin: 0;
  }

  @media (min-width: 768px) {
    .hero {
      min-height: 37rem;
    }

    .hero h1 {
      font-size: 2.75rem;
    }

    .hero p {
      font-size: 1.25rem;
    }
  }
</style>
