---
import ImpressionBreak from '../components/ImpressionBreak.astro';
import Layout from '../layouts/Layout.astro';
import ServiceHero from '../components/ServiceHero.astro';

import heroImage from '../images/impressions/impression_32.jpg';

import impression_102 from '../images/impressions/impression_102.jpg';
---

<Layout
  title="Workshops am Alpakahof"
  description="Alpaka-Yoga sowie Filzen und Spinnen mit Alpakawolle: Unsere Workshops sind für Gruppen individuell vereinbar."
  navTransparentOnHero={true}
  hideLogoOnTransparent={false}
>
  <ServiceHero
    title="Workshops am Alpakahof"
    description="Gemeinsam Zeit verbringen, Neues ausprobieren und unseren Alpakas ganz nah sein."
    image={heroImage}
    imageAlt="Rohwolle wird am Hof zu Garn verarbeitet"
    className="service-hero"
  />

  <section class="service-page section">
    <div class="container">
      <h2>Unser Workshop-Angebot</h2>
      <h3>Alpaka-Yoga</h3>
      <p>Genießt eine besondere gemeinsame Auszeit beim Yoga inmitten unserer Alpakas.</p>
      <h3>Filzen und Spinnen</h3>
      <p>
        Lernt unsere Alpakawolle kennen und probiert selbst aus, wie sie beim Filzen und am Spinnrad
        verarbeitet wird.
      </p>
      <p>
        <strong>Alle Workshops sind für Gruppen individuell vereinbar.</strong>
        Schreibt uns über das <a href="/#kontakt">Kontaktformular</a>, damit wir Inhalt und Termin
        gemeinsam abstimmen können.
      </p>
    </div>
  </section>

  <ImpressionBreak image={impression_102} alt="Richard im Stall" backgroundPosition="center 40%" />
</Layout>

<style>
  .service-page {
    background-color: var(--taubenblau);
    color: var(--schurwolle);
  }
</style>
