---
import ImpressionBreak from '../components/ImpressionBreak.astro';
import Layout from '../layouts/Layout.astro';
import ServiceHero from '../components/ServiceHero.astro';
import Slideshow, { type StorySlide } from '../components/Slideshow.astro';

import Wanderung1 from '../images/wanderungen/wanderung1.jpg';
import Wanderung2 from '../images/wanderungen/wanderung2.jpg';
import Wanderung3 from '../images/wanderungen/wanderung3.jpg';
import Wanderung4 from '../images/wanderungen/wanderung4.jpg';

import heroImage from '../images/impressions/impression_64.jpg';

import impression_72 from '../images/impressions/impression_72.jpg';

const slideData = [
  {
    src: Wanderung1,
    alt: 'Eine Frau führt zwei cremeweiße Alpakas über eine Wiese, dahinter Häuser und Bäume im Abendlicht',
    title: "Los geht's",
    text: 'Bevor es losgeht, lernst du bei einem Hofbesuch deine Begleiter in Ruhe kennen.',
    focal: 'center 60%',
  },
  {
    src: Wanderung2,
    alt: 'Ein Mann geht in kurzer Hose mit einem hellbraunen Alpaka an roter Leine über einen asphaltierten Weg neben einer grünen Wiese',
    title: 'Auf dem Flurweg',
    text: 'Zwischen Wiesen und Getreidefeldern führt der Weg direkt vom Hof los. Das Alpaka trottet locker an der Leine mit und schaut gelegentlich, wo du bleibst.',
    focal: 'center 70%',
  },
  {
    src: Wanderung3,
    alt: 'Zwei Personen führen ein schwarzes und ein braunes Alpaka von hinten gesehen über eine Wiese mit trockenem Gras',
    title: 'Querfeldein',
    text: 'Abseits der Straße geht es über Wiesenpfade, ganz in der Nähe der Inn-Auen und manchmal auch mitten hinein.',
  },
  {
    src: Wanderung4,
    alt: 'Blick über die Schulter auf drei Alpakas und zwei Personen, die sie an Leinen über einen asphaltierten Weg am Feld führen',
    title: 'An der Leine',
    text: 'Die Leine liegt in deiner Hand, und in zwei Stunden bleibt genug Zeit, Fragen zu stellen und die Tiere zu beobachten.',
    focal: 'center 32%',
  },
];

const slides: StorySlide[] = slideData.map((slide, i) => ({
  ...slide,
  kicker: `Moment ${String(i + 1).padStart(2, '0')}`,
}));
---

<Layout
  title="Alpaka-Wanderungen"
  description="Geführte Alpakawanderung im Innviertel: gemütliche Touren mit unseren Alpakas, inklusive Hofbesuch. Dauer, Preise und Ausflugstipps im Überblick."
  navTransparentOnHero={true}
  hideLogoOnTransparent={false}
>
  <ServiceHero
    title="Alpaka-Wanderungen"
    description="Entdecke bei einer Wanderung durch die Inn Auen die Natur an der Seite unserer freundlichen Alpakas. Ein Hofbesuch mit Kennenlernen der Tiere ist inklusive."
    image={heroImage}
    imageAlt="Alpakas auf einer Wanderung durch die Inn-Auen"
    imagePosition="center 40%"
    className="wander-hero"
  >
    <a href="/#kontakt" class="btn">
      Jetzt Alpaka-Tour buchen
    </a>
  </ServiceHero>

  <section class="details section">
    <div class="container">
      <h2>Details</h2>
      <p>
        Bei einer gemütlichen Runde über unsere Felder lernst du die Tiere kennen und kannst die
        Landschaft genießen.
      </p>
      <ul class="details-list">
        <li>
          <strong>Preis:</strong> 30&nbsp;€ pro Person mit Tier, gerne erstellen wir bei Anfrage ein
          individuelles Angebot für Familien und Gruppen
        </li>
        <li>
          <strong>Dauer:</strong> ca. 2&nbsp;Stunden
        </li>
        <li>
          <strong>Hinweis:</strong> Hunde können leider nicht mitwandern
        </li>
        <li>
          <strong>Begleitung:</strong> Bei Kindern unter 14 Jahren ist pro Alpaka eine Begleitperson
          notwendig
        </li>
      </ul>
      <div style="text-align: center; margin-top: 3rem;">
        <a href="/#kontakt" class="btn">
          Jetzt Alpaka-Tour buchen
        </a>
      </div>
    </div>
  </section>

  <Slideshow slides={slides} label="Momentaufnahmen von der Wanderung" eyebrow="Unterwegs am Inn" />

  <section class="info-box section">
    <div class="container">
      <h2>Ausflugstipps</h2>
      <p>
        Für eine Stärkung nach der Wanderung empfiehlt sich die
        <a
          href="https://www.burg-frauenstein.com/"
          class="link"
          target="_blank"
          rel="noopener noreferrer"
        >
          Burgschänke Frauenstein
        </a>
        mit regionaler Küche und gemütlichem Gastgarten.
      </p>
      <!-- prettier-ignore -->
      <p>
        Ganz in der Nähe liegt das
        <a
          href="https://www.naturium-am-inn.eu/"
          class="link"
          target="_blank"
          rel="noopener noreferrer"
          >Naturium Ering</a
        >. Dort erhältst du spannende Einblicke in die Vogelwelt des Europareservats Unterer Inn und
        kannst von Aussichtstürmen seltene Arten beobachten.
      </p>
    </div>
  </section>

  <ImpressionBreak
    image={impression_72}
    alt="Alpakas auf der Weide"
    backgroundPosition="center 40%"
  />
</Layout>

<style>
  .wander-hero .btn {
    margin-top: 0.5rem;
  }

  .details-list {
    list-style: none;
    padding: 0;
  }

  .details-list li {
    margin-bottom: 0.5rem;
  }

  .info-box {
    background-color: var(--himmelblau);
    color: var(--schurwolle);
    text-align: center;
  }
</style>
