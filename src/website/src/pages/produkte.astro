---
import Layout from '../layouts/Layout.astro';
import ServiceHero from '../components/ServiceHero.astro';
import Slideshow, { type StorySlide } from '../components/Slideshow.astro';

import heroImage from '../images/impressions/impression_7.jpg';

import Strickgabel from '../images/produkte/Strickgabel.jpeg';
import WolleAmadeus from '../images/produkte/Wolle_Amadeus.jpg';
import Karten from '../images/produkte/IMG_8484.jpeg';
import Polster from '../images/produkte/Polster.jpg';
import Wollpellets from '../images/produkte/IMG_7945.jpeg';
import Garn from '../images/produkte/IMG_8734.jpeg';
import GrauesGarn from '../images/produkte/IMG_9795.jpeg';
import Siebdruck from '../images/produkte/IMG_8481.jpeg';
import PolsterLeinen from '../images/produkte/IMG_8617.jpeg';
import PolsterRosa from '../images/produkte/IMG_8622.jpeg';
import Wollkugel from '../images/produkte/IMG_8439.jpeg';
import Filzsohlen from '../images/produkte/IMG_8398.jpeg';
import Filzeier from '../images/produkte/IMG_9053.jpeg';
import Osterei from '../images/produkte/IMG_9084.jpeg';
import Filzfigur from '../images/produkte/IMG_9054.jpeg';
import Rotkehlchen from '../images/produkte/IMG_8372.jpeg';
import Sonnenfaenger from '../images/produkte/IMG_9183.jpeg';
import Adventkranz from '../images/produkte/IMG_8520.jpeg';

const slideData = [
  {
    src: Strickgabel,
    alt: 'Hölzerne Strickgabel mit einer angestrickten Kordel aus schwarzem Garn mit bunten Fäden, daneben ein Knäuel',
    label: 'Hofladen',
    title: 'Strickgabel',
    text: 'Eine Holzgabel, ein Faden, mehr braucht es nicht: Mit der Strickgabel entsteht Masche für Masche eine Kordel, ganz ohne Nadeln.',
    focal: 'center 40%',
  },
  {
    src: WolleAmadeus,
    alt: 'Strang dunkelbrauner Alpakawolle neben grünen Tannen- und Thujazweigen',
    label: 'Hofladen',
    title: 'Wolle Amadeus',
    text: 'Ein dunkles Schokobraun, so wie es Amadeus trägt: ungefärbt und von Hand gesponnen.',
  },
  {
    src: Garn,
    alt: 'Strang naturweißer, handgesponnener Alpakawolle auf einem weißen Schaffell',
    label: 'Hofladen',
    title: 'Naturweiße Wolle',
    text: 'Handgesponnen und ungefärbt: Wolle in den natürlichen Farben unserer Tiere.',
  },
  {
    src: GrauesGarn,
    alt: 'Grau melierter Wollstrang, daneben ein Stück gestricktes Gewebe',
    label: 'Hofladen',
    title: 'Graue Wolle',
    text: 'Grau meliert, weich und warm: ein Strang, der gleich zum Verstricken einlädt.',
  },
  {
    src: Karten,
    alt: 'Türkisgrüne Klappkarten mit ausgespartem Alpaka-Motiv auf einem Holzboden, im Hintergrund Druckutensilien',
    label: 'Hofladen',
    title: 'Karten',
    text: 'Für jeden Anlass liegt etwas Handgemachtes bereit – vom Geburtstagsgruß bis zum kleinen Danke. Wer mag, legt gleich einen Gutschein für ein Alpaka-Erlebnis dazu.',
  },
  {
    src: Siebdruck,
    alt: 'Siebdruckrahmen auf einem Holztisch, davor leinenfarbene Stoffsackerl mit Alpaka-Logo und dem Schriftzug amadeus',
    label: 'Hofladen',
    title: 'Siebdruck',
    text: 'Die Stoffsackerl mit Alpaka-Logo und Namen werden bei uns von Hand im Siebdruck bedruckt.',
  },
  {
    src: Polster,
    alt: 'Zwei Leinenpölster mit gestempeltem Alpaka-Logo und den Namen Ludwig und Amadeus, auf einem weißen Schaffell',
    label: 'Zuhause',
    title: 'Pölster',
    text: 'Herrlich weiche Pölster, gefüllt mit der Wolle unserer Tiere – sie wärmen im Winter und lassen an warmen Tagen die Faser atmen.',
  },
  {
    src: PolsterLeinen,
    alt: 'Weißer Leinenpolster mit kleinem Alpaka-Motiv auf einem Holztisch, dahinter Rohwolle in Braun',
    label: 'Zuhause',
    title: 'Leinenpolster',
    text: 'Der Bezug aus Leinen, die Füllung aus der Wolle unserer Tiere.',
  },
  {
    src: PolsterRosa,
    alt: 'Rosafarbener Polster auf einer Bank vor weiteren Kissen',
    label: 'Zuhause',
    title: 'Polster in Rosa',
    text: 'Pölster gibt es in verschiedenen Farben, passend für Sofa, Bank und Bett.',
  },
  {
    src: Wollpellets,
    alt: 'Drei Kraftpapiersackerl mit handgeschriebenem "Alpaka Wollpellets" und Sichtfenster, davor ein weißes Schaffell',
    label: 'Für den Garten',
    title: 'Wollpellets',
    text: 'Von der Schur zurück auf die Weide: naturreine Wollpellets, die deinen Beeten langsam und sanft Nahrung geben.',
  },
  {
    src: Wollkugel,
    alt: 'Verschnürte Kugel aus weißer Wolle, die an einem Rosenstrauch mit Hagebutten hängt',
    label: 'Für den Garten',
    title: 'Wollkugel',
    text: 'Ein Büschel Alpakawolle, zum Aufhängen im Garten verschnürt.',
  },
  {
    src: Filzsohlen,
    alt: 'Gestapelte graubraune Filzsohlen, jeweils mit einer Banderole umwickelt',
    label: 'Hofladen',
    title: 'Filzsohlen',
    text: 'Aus Alpakafilz gefertigt, für warme Füße in der kalten Jahreszeit.',
  },
  {
    src: Filzeier,
    alt: 'Drei gefilzte Eier zum Aufhängen mit bunten Mustern auf grauem Filz',
    label: 'Saisonales',
    title: 'Filzeier',
    text: 'Bunt gestreift, blumig oder zart: Osterschmuck aus gefilzter Alpakawolle.',
  },
  {
    src: Osterei,
    alt: 'Gefilztes Osterei mit Narzisse und Wiesenblumen auf weißer Wolle',
    label: 'Saisonales',
    title: 'Gefilztes Osterei',
    text: 'Jedes Ei wird von Hand gefilzt und ist ein Unikat.',
  },
  {
    src: Filzfigur,
    alt: 'Filzfigur in grauem Gewand, die einen Bund Weidenkätzchen trägt, auf weißer Wolle',
    label: 'Saisonales',
    title: 'Filzfigur',
    text: 'Eine kleine Figur aus Wolle mit Weidenkätzchen im Arm, ein Gruß aus dem Frühling.',
  },
  {
    src: Rotkehlchen,
    alt: 'Gefilzte Kugel mit Rotkehlchen, die vor einer Holzwand hängt',
    label: 'Saisonales',
    title: 'Rotkehlchen',
    text: 'Gefilzte Anhänger mit Vogelmotiv, zum Aufhängen und Verschenken.',
  },
  {
    src: Sonnenfaenger,
    alt: 'Hängender Fensterschmuck mit Glasperlen, Kristallen und kleinen Filzkugeln',
    label: 'Saisonales',
    title: 'Fensterschmuck',
    text: 'Filzperlen und Glasperlen, die das Licht im Fenster einfangen.',
  },
  {
    src: Adventkranz,
    alt: 'Adventkranz mit dunkelroten Kerzen, Tannenzweigen und Dekoration aus Wolle',
    label: 'Saisonales',
    title: 'Adventkranz',
    text: 'Zur Adventzeit gibt es Kränze und Gestecke mit Schmuck aus Wolle.',
  },
];

const slides: StorySlide[] = slideData.map((slide, i) => {
  const { label, ...rest } = slide;
  return { ...rest, kicker: `${String(i + 1).padStart(2, '0')} · ${label}` };
});
---

<Layout
  title="Produkte"
  description="Alpakawolle, handgefertigte Accessoires, Pölster mit Alpakafüllung und Wollpellets als Dünger — direkt aus dem Hofladen der Alpakasölde."
  navTransparentOnHero={true}
  hideLogoOnTransparent={false}
>
  <ServiceHero
    title="Produkte"
    description="Entdecke die vielfältigen Produkte aus der weichen Alpakawolle in unserem Hofladen."
    image={heroImage}
    imageAlt="Produkte aus Alpakawolle im Hofladen der Alpakasölde"
    className="service-hero"
  />

  <section class="service-page section">
    <div class="container">
      <h2>Aus unserem Hofladen</h2>
      <p>
        Tauche ein in die kuschelweiche Welt der Alpakas: In unserem Hofladen findest du
        handgesponnene Wolle, liebevoll gefertigte Accessoires und viele weitere Kostbarkeiten.
      </p>
      <p>
        Ob herrlich weiche Pölster mit Alpakafüllung, Wolle mit Strickgabel oder naturreine
        Wollpellets als Dünger – hier entdeckst du, wie vielseitig Alpaka sein kann. Ein Blick in
        unseren Schaukasten lohnt sich immer.
      </p>
      <p>
        Auf Vorbestellung können wir dir auch gerne eine persönliche Decke aus feinster Alpakafaser
        anbieten.
      </p>
    </div>
  </section>
  <section class="section">
    <Slideshow slides={slides} label="Fotos aus unserem Hofladen" eyebrow="Aus unserem Hofladen" />
  </section>
</Layout>

<style>
  .service-page {
    background-color: var(--auwasser);
    color: var(--taubenblau);
  }
</style>
