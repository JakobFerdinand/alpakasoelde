---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import WorkshopLayout from '../../layouts/WorkshopLayout.astro';
import AlpakaLogo from '../../images/AS_Symbolik_Taubenblau.svg';
import { farm } from '../../data/farm';
import {
  buildEventJsonLd,
  endsAt,
  formatDateLong,
  formatDayBlock,
  formatTimeRange,
  isUpcoming,
} from '../../data/veranstaltung';

// Past events keep a page too, so shared links do not break.
export async function getStaticPaths() {
  return (await getCollection('veranstaltungen')).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const past = !isUpcoming(data, new Date());
const { month, day } = formatDayBlock(data.start);
const phone = data.contact?.phone ?? farm.phone;
const location = data.location ?? `${farm.name} | ${farm.address.street}`;
const structuredData = buildEventJsonLd({ ...data, id: entry.id }, Astro.site!);
---

<WorkshopLayout
  title={data.title}
  description={data.summary}
  robots={past ? 'noindex, follow' : undefined}
  structuredData={structuredData}
>
  <p
    class="past-notice container"
    role="status"
    data-reveal-at={endsAt(data).toISOString()}
    hidden={!past}
  >
    Diese Veranstaltung hat bereits stattgefunden
  </p>

  <section class:list={['photo-hero', { 'photo-hero--no-cover': !data.cover }]}>
    <div class="container photo-hero__grid">
      <div class="photo-hero__date">
        <span class="photo-hero__month">{month}</span>
        <span class="photo-hero__day">{day}</span>
      </div>
      {data.cover && (
        <div class="photo-hero__cover">
          <Image
            src={data.cover.image}
            alt={data.cover.alt}
            widths={[480, 720, 1080]}
            sizes="(max-width: 800px) 66vw, 530px"
          />
        </div>
      )}
    </div>
  </section>

  <section class="title-banner">
    <div class="container title-banner__inner">
      <h1>{data.title}</h1>
      <div class="title-banner__logo">
        <AlpakaLogo aria-hidden="true" />
      </div>
    </div>
  </section>

  <section class="details section">
    <div class="container details__inner">
      <p class="details__location">
        {formatDateLong(data.start)}&ensp;|&ensp;{formatTimeRange(data)}&ensp;|&ensp;{location}
      </p>

      <div class="details__grid">
        <div class="details__block">
          <p>{data.summary}</p>
        </div>

        {data.highlights.length > 0 && (
          <div class="details__block">
            <h2>Das erwartet dich:</h2>
            <ul>
              {data.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}

        {data.bring.length > 0 && (
          <div class="details__block">
            <h2>Mitzubringen:</h2>
            <ul>
              {data.bring.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )}

        {data.price && (
          <div class="details__block">
            <h2>Kosten:</h2>
            <p>{data.price}</p>
          </div>
        )}

        <div class="details__block details__body">
          <Content />
        </div>

        <div class="details__block details__block--cta">
          <h2>Anmeldung und Infos:</h2>
          <div class="details__contact-row">
            <p>
              {data.contact?.name && <>{data.contact.name}&ensp;|&ensp;</>}
              <a href={`tel:${phone.replace(/[^+\d]/g, '')}`}>{phone}</a>
            </p>
            <a href="/#kontakt" class="btn">
              Jetzt anmelden
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <p class="back container">
    <a href="/#veranstaltungen">← Zurück zur Startseite</a>
  </p>
</WorkshopLayout>

<style>
  .past-notice {
    max-width: 800px;
    margin: 1rem auto 0;
    padding: 0.75rem 1rem;
    background-color: var(--backstein);
    color: var(--schurwolle);
    text-align: center;
    font-weight: 600;
  }

  .past-notice[hidden] {
    display: none;
  }

  /* ---- Photo hero ---- */
  .photo-hero {
    padding: 2rem 0 0;
  }

  .photo-hero__grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 0.75rem;
    max-width: 800px;
  }

  .photo-hero--no-cover .photo-hero__grid {
    grid-template-columns: 1fr;
  }

  .photo-hero__date {
    background-color: var(--taubenblau);
    color: var(--schurwolle);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 1rem;
    line-height: 1;
  }

  .photo-hero__month {
    font-size: 1.1rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .photo-hero__day {
    font-size: clamp(3rem, 8vw, 4.5rem);
    font-weight: 300;
    margin-top: 0.15rem;
  }

  .photo-hero__cover {
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .photo-hero__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ---- Title banner ---- */
  .title-banner {
    padding: 0.75rem 0 0;
  }

  .title-banner__inner {
    display: flex;
    align-items: stretch;
    gap: 0.75rem;
    max-width: 800px;
  }

  .title-banner h1 {
    flex: 1;
    background-color: var(--bluetenhonig);
    color: var(--schurwolle);
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.6rem 1.5rem;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .title-banner__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .title-banner__logo :global(svg) {
    width: 68px;
    height: 68px;
  }

  /* ---- Details section ---- */
  .details {
    padding-top: 0.75rem;
    padding-bottom: 1.5rem;
  }

  .details__inner {
    max-width: 800px;
  }

  .details__location {
    background-color: var(--auwasser);
    color: var(--taubenblau);
    font-size: clamp(1rem, 3vw, 1.25rem);
    margin: 0;
    padding: 1.75rem 2rem 0;
  }

  .details__grid {
    background-color: var(--auwasser);
    color: var(--taubenblau);
    padding: 1.5rem 2rem 2rem;
  }

  .details__block {
    margin-bottom: 1.25rem;
  }

  .details__block:last-child {
    margin-bottom: 0;
  }

  .details__block h2 {
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 0.25rem;
    text-align: left;
  }

  .details__block p {
    margin: 0;
    line-height: 1.7;
  }

  .details__block ul {
    padding-left: 1.25rem;
    margin: 0;
    line-height: 1.7;
  }

  .details__body:empty,
  .details__body:not(:has(*)) {
    display: none;
  }

  .details__body :global(p) {
    margin: 0 0 0.75rem;
  }

  .details__grid a:not(.btn),
  .details__body :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .details__contact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .details__contact-row p {
    margin: 0;
  }

  .details__contact-row :global(.btn) {
    flex-shrink: 0;
    background-color: var(--taubenblau);
    color: var(--schurwolle);
  }

  .back {
    max-width: 800px;
    margin: 0 auto 3rem;
  }

  .back a {
    color: var(--taubenblau);
  }

  @media (max-width: 600px) {
    .photo-hero__grid {
      gap: 0.5rem;
    }

    .photo-hero__date {
      padding: 1rem 0.75rem;
    }

    .photo-hero__day {
      font-size: clamp(2.5rem, 12vw, 4.5rem);
    }

    .title-banner__logo :global(svg) {
      width: 52px;
      height: 52px;
    }

    .details__location {
      padding: 1.25rem 1.25rem 0;
    }

    .details__grid {
      padding: 1.25rem;
    }

    .details__contact-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
