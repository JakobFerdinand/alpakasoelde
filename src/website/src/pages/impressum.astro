---
import Layout from '../layouts/Layout.astro';
import { farm } from '../data/farm';
---

<Layout
  title="Impressum"
  description="Impressum der Alpakasölde: Anbieterkennzeichnung, Kontaktdaten und Verantwortliche für alpakasoelde.at."
>
  <section class="service-page section">
    <div class="container">
      <h1>Impressum</h1>
      <p>Alpakasoelde<br />
Jakob Wegenschimmel<br />
{farm.address.street}, {farm.address.postalCode} {farm.address.locality}<br />
{farm.address.countryName}<br />
Tel: {farm.phone}<br />
E-Mail: <a href={`mailto:${farm.email}`} class="link">{farm.email}</a><br />
</p>
    </div>
  </section>
</Layout>

<style>
  .service-page {
    background-color: var(--auwasser);
    color: var(--taubenblau);
  }
</style>
